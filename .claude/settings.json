{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "PYTHONUTF8=1 PYTHONIOENCODING=utf-8 python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\"",
            "timeout": 60,
            "statusMessage": "git 규칙 확인 중"
          }
        ]
      }
    ]
  }
}
